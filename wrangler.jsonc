{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arra-memory-lab",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arra-memory-lab",
      "database_id": "8f501f5c-8c48-47f5-ba63-5773d73fc9a0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "81dab83eba964ff68516aa61754868fe"
    }
  ],
  "vars": {
    "SEMANTIC_MAX_DISTANCE": "0.7"
  }
}
